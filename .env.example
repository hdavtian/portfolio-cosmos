# Frontend build variables. Copy to .env (git-ignored).
#
# Vite reads .env from the REPO ROOT, not from api/. Values prefixed with VITE_
# are inlined into the bundle at build time, so they are public once deployed:
# never put a server secret here.
#
# api/.env is separate and configures the Express API.

# Where the site and admin call the API. Local development uses the Docker API;
# `npm run dev:full` injects this automatically.
VITE_API_BASE_URL=http://localhost:8080

# Set to "on" to let bundled content stand in when the API can't be reached.
# Off by default while the sites are moved onto the API, so failures are visible.
VITE_CONTENT_FALLBACK=

# Syncfusion Community License, used by the admin's Syncfusion components.
# Without it the grids and dialogs render but show a licence banner.
# Production builds read it from the GitHub Actions secret SYNCFUSION_LICENSE_KEY.
VITE_SYNCFUSION_LICENSE_KEY=

# PostHog analytics. Only initialises on harmadavtian.com / www, so local runs
# and the admin send nothing. Production values come from GitHub Actions vars.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://t.harmadavtian.com
