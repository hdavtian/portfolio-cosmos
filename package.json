{
  "name": "scrolling-resume",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "api:dev": "npm run dev -w api",
    "api:local": "node scripts/with-local-env.mjs --api",
    "storage:cors": "node scripts/with-local-env.mjs npm run storage:cors -w api",
    "api:build": "npm run build -w api",
    "api:start": "npm run start -w api",
    "dev:full": "node scripts/dev-full.mjs",
    "dev:full-restart": "node scripts/dev-full.mjs --restart",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose stop",
    "az:guard": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/az-guard.ps1",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:add-stormscape-return": "node scripts/with-local-env.mjs npm run add-stormscape-return -w api",
    "content:fallback": "node scripts/content-fallback.mjs",
    "db:pull": "node scripts/db-pull.mjs",
    "db:restore-local": "node scripts/db-restore-local.mjs",
    "db:backup-local": "node scripts/db-backup-local.mjs",
    "db:push-prod": "node scripts/db-push-prod.mjs",
    "media:pull": "node scripts/media-pull.mjs",
    "media:push-prod": "node scripts/media-push-prod.mjs",
    "db:ensure-indexes-prod": "node scripts/db-ensure-indexes-prod.mjs",
    "admin:dev": "vite --config vite.admin.config.ts",
    "build:admin": "tsc -p tsconfig.admin.json --noEmit && vite build --config vite.admin.config.ts",
    "typecheck:admin": "tsc -p tsconfig.admin.json --noEmit",
    "skills:migrate": "node scripts/skills-migrate.mjs",
    "skills:write": "node scripts/skills-migrate-write.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@syncfusion/ej2-base": "^34.2.8",
    "@syncfusion/ej2-react-buttons": "^34.2.8",
    "@syncfusion/ej2-react-calendars": "^34.2.8",
    "@syncfusion/ej2-react-dropdowns": "^34.2.8",
    "@syncfusion/ej2-react-grids": "^34.2.8",
    "@syncfusion/ej2-react-inputs": "^34.2.8",
    "@syncfusion/ej2-react-navigations": "^34.2.8",
    "@syncfusion/ej2-react-notifications": "^34.2.8",
    "@syncfusion/ej2-react-popups": "^34.2.8",
    "@syncfusion/ej2-react-treegrid": "^34.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/query-sync-storage-persister": "^5.99.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-persist-client": "^5.99.0",
    "@tonejs/midi": "^2.0.28",
    "@types/three": "^0.182.0",
    "camera-controls": "^3.1.2",
    "d3": "^7.9.0",
    "gsap": "^3.14.2",
    "posthog-js": "^1.364.6",
    "react": "^19.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.14.1",
    "sass": "^1.97.1",
    "tailwindcss": "^4.2.2",
    "three": "^0.182.0",
    "three-globe": "^2.45.1",
    "tone": "^15.1.22",
    "yuka": "^0.7.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  },
  "workspaces": [
    "api",
    "packages/*"
  ],
  "overrides": {
    "tsx": {
      "esbuild": "0.27.2"
    }
  }
}
