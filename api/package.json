{
  "name": "scrolling-resume-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit && node ../scripts/build-api.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "add-stormscape-return": "tsx src/scripts/addStormscapeReturn.ts",
    "storage:cors": "tsx src/scripts/configureLocalStorageCors.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.33.0",
    "@hd/content-schema": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "image-size": "^2.0.4",
    "mongodb": "^6.20.0",
    "mongoose": "^8.19.3",
    "morgan": "^1.10.1",
    "multer": "^2.4.0",
    "sharp": "^0.35.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.6.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
