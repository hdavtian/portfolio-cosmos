# Local development defaults. Copy to api/.env and leave these values alone:
# they target the Docker services started by `npm run dev:full`.
#
# Production values live in Azure app settings for harma-api, never in a file
# here. `npm run db:pull` finds the production URI from MONGODB_URI, then
# api/.env.production.local (git-ignored), then Azure app settings.
PORT=8080
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=resume_cosmos_local
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:5173

# Azurite (local blob storage) well-known development account.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
AZURE_STORAGE_CONTAINER=media

# Shared sign-on (hd_session cookie), required in production.
#
# Production values are generated centrally and written to every app at once:
#   cd C:\sites\shared-login-for-personal-apps && npm run creds:set -- "<password>"
# Never generate per-app credentials: different values silently break SSO.
# They live in the harma-api Azure app settings, not in a file here.
#
# For local development, throwaway values are fine (any password you like):
#   node -e "const{randomBytes,scryptSync}=require('node:crypto');const s=randomBytes(16);console.log(['scrypt',16384,8,1,s.toString('base64'),scryptSync('local-dev',s,64,{N:16384,r:8,p:1}).toString('base64')].join('$'))"
AUTH_PASSWORD_HASH=
AUTH_COOKIE_SECRET=
# Set to .harmadavtian.com in production so one login covers every subdomain.
# Leave empty locally (localhost cookies must not carry a domain).
AUTH_COOKIE_DOMAIN=
AUTH_SESSION_TTL_SECONDS=2592000

# Extra origins allowed to send credentialed requests, comma-separated.
# http://localhost:5173 and FRONTEND_ORIGIN are always allowed.
CORS_ORIGINS=

# Contact form mail (HD-4). Both optional, including in production.
#
# Unset means the form still accepts and stores every message, and each row
# records that nobody was emailed about it -- deliberately, so a rotated or
# revoked password can never lose somebody's note. The admin's settings page
# says plainly when sending is off.
#
# GMAIL_APP_PASSWORD is a 16-character app password, NOT the account
# password: Google refuses the account password for SMTP. Generate one at
#   Google Account -> Security -> 2-Step Verification -> App passwords
# (2-Step Verification must be on before the option appears). Paste it
# without the spaces Google shows it with.
#
# Production values go in the harma-api Azure app settings, never in a file
# here -- the same rule as the sign-on secrets above.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Display name on outgoing mail. The address is GMAIL_USER; a visitor's own
# address goes in Reply-To, never From.
MAIL_FROM_NAME=Harma Davtian
# Where the confirmation email points the reader back to.
SITE_PUBLIC_URL=https://harmadavtian.com
