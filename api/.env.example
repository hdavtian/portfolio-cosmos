PORT=8080
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=resume_cosmos
LOG_LEVEL=info
FRONTEND_ORIGIN=https://harmadavtian.com

# Local development does not read these values: `npm run dev:full` injects the
# Docker MongoDB and Azurite settings from scripts/local-env.mjs, and injected
# variables take precedence over this file.
